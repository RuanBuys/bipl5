is_correlation<-function(x){
basis<-x$e.vects
new_x<-biplotEZ::biplot(x$raw.X,scaled = x$scaled,center = x$center)|>
biplotEZ::PCA(e.vects=basis)
#test in the ax.one.unit if they are the same
diff<-sum(x$ax.one.unit-new_x$ax.one.unit)
return(diff!=0)
}
